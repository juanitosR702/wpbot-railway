# BandalandBot: plantilla para un entorno del VPS. No subas el .env real.
NODE_ENV=production
TZ=America/Bogota

# Bot (obligatorias para una instalación identificable)
PREFIX=!
CREATOR_NUMBERS=
BOT_NUMBERS=

# Persistencia y conexión (obligatorias)
# Debe apuntar a MongoDB externo o gestionado; no se inicia MongoDB en este Compose.
MONGODB_URI=
MONGODB_DB=bot_whatsapp
# Ruta dentro del contenedor, montada por compose.yml. No la cambies sin cambiar el volumen.
AUTH_DIR=/app/bridge/auth

# Visor de QR privado; el compose lo publica únicamente en 127.0.0.1 del VPS.
PORT=3000
QR_ACCESS_TOKEN=

# IA: GEMINI_API_KEY es obligatoria sólo si AI_PROVIDER=gemini.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TEMPERATURE=0.4
# GEMINI_MAX_TOKENS=700
# AI_SYSTEM_PROMPT=
# AI_FALLBACK_TIMEOUT_MS=60000

# Cadena de respaldo de la IA (opcional): Gemini -> OpenRouter -> NVIDIA.
# Cada tramo se activa solo si su clave existe. OPENROUTER_API_KEY y
# NSFW_NVIDIA_API_KEY se comparten con el modulo anti-NSFW.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/auto
# NVIDIA_API_KEY=            (si falta, se reutiliza NSFW_NVIDIA_API_KEY)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# IA compatible con OpenAI, necesaria sólo si AI_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Anti-NSFW. Valores: disabled, local, gemini, openrouter, openai,
# sightengine, nudenet o custom. Cada proveedor remoto requiere su clave/URL.
NSFW_PROVIDER=disabled
# NSFW_THRESHOLD=0.85
# NSFW_TIMEOUT_MS=15000
# NSFW_MAX_BYTES=8388608
# NSFW_CACHE_TTL_MS=600000
# NSFW_CACHE_MAX_ENTRIES=100
# NSFW_KICK_THRESHOLD=3
# SIGHTENGINE_URL=https://api.sightengine.com/1.0/check.json
# SIGHTENGINE_MODELS=nudity-2.1
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# NUDENET_URL=http://host.docker.internal:8080
# NSFW_NUDENET_URL=http://host.docker.internal:8080
# NSFW_CUSTOM_URL=http://host.docker.internal:9000/check
# NSFW_GEMINI_MODEL=gemini-2.5-flash
# NSFW_OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NSFW_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Música. yt-dlp está incluido en la imagen. YTDLP_COOKIES, si se usa, debe ser
# una ruta dentro del contenedor proporcionada mediante un override privado.
YTDLP_PATH=yt-dlp
# YTDLP_COOKIES=
