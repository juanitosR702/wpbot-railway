# ============================================================
# BandalandBot — Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================================

# --- Bot ---
PREFIX=!
# Numeros del creador (con codigo de pais, separados por coma)
CREATOR_NUMBERS=573126068076
# Numero(s) del bot mismo (con codigo de pais)
BOT_NUMBERS=573026525974

# --- IA (Google Gemini) --- REQUERIDO para !ai / !ask / !resume ---
GEMINI_API_KEY=
# Modelo a usar (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TEMPERATURE=0.4
# GEMINI_MAX_TOKENS=700

# --- Anti-NSFW ---
# Proveedor: disabled | local | gemini | openai | openrouter | sightengine | nudenet | custom | nvidia
NSFW_PROVIDER=disabled
# NSFW_THRESHOLD=0.75
# NSFW_KICK_THRESHOLD=3

# Solo si NSFW_PROVIDER=sightengine:
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=

# Solo si NSFW_PROVIDER=nudenet (self-hosted):
# NUDENET_URL=http://localhost:8080

# Solo si NSFW_PROVIDER=custom:
# NSFW_CUSTOM_URL=http://localhost:9000/check

# Solo si NSFW_PROVIDER=nvidia (NVIDIA Nemotron Content Safety):
# API key de https://build.nvidia.com (recursos → Safety & Moderation)
# NSFW_NVIDIA_API_KEY=
# NSFW_NVIDIA_MODEL=nvidia/nemotron-3.5-content-safety

# --- MongoDB --- REQUERIDO para persistencia de datos ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bot_whatsapp

# --- API oficial de Meta (Cloud API) ---
# Modo de conexión:
#   baileys (default) -> solo Baileys
#   cloud             -> solo API oficial (webhook)
#   both              -> Baileys Y API oficial al mismo tiempo
# WHATSAPP_API=both
# Token permanente de acceso a la Graph API (Meta → WhatsApp → Configuración de API)
# WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono (Phone number ID, distinto del WABA ID)
# WHATSAPP_PHONE_NUMBER_ID=
# Token de verificación libre que pongas en Meta → Webhook → Verificar y guardar
# WHATSAPP_VERIFY_TOKEN=
# App secret para validar firmas X-Hub-Signature-256 (opcional, recomendado)
# WHATSAPP_APP_SECRET=
# Número del bot (con código de país) para identificar sus propios mensajes
# WHATSAPP_BOT_PHONE=
# Versión de la Graph API (default: v25.0)
# GRAPH_API_VERSION=v25.0
